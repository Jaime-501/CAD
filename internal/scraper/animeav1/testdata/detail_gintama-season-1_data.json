{"type":"data","nodes":[null,{"type":"data","data":[{"user":1},null],"uses":{"dependencies":["https://animeav1.com/media/auth"]}},{"type":"data","data":[{"media":1},{"id":2,"categoryId":3,"title":4,"aka":5,"genres":7,"synopsis":40,"poster":41,"backdrop":41,"trailer":41,"status":10,"runtime":41,"startDate":42,"nextDate":41,"endDate":43,"waitDays":44,"featured":45,"mature":45,"episodesCount":46,"score":47,"votes":48,"slug":49,"malId":50,"seasons":41,"createdAt":51,"updatedAt":52,"category":53,"episodes":57,"relations":644},198,1,"Gintama",{"ja-jp":6},"銀魂",[8,12,16,21,26,30,35],{"id":3,"name":9,"type":10,"slug":11,"malId":3},"Acción",0,"accion",{"id":13,"name":14,"type":10,"slug":15,"malId":13},4,"Comedia","comedia",{"id":17,"name":18,"type":10,"slug":19,"malId":20},3,"Ciencia Ficción","ciencia-ficcion",24,{"id":22,"name":23,"type":10,"slug":24,"malId":25},13,"Shounen","shounen",27,{"id":27,"name":28,"type":3,"slug":29,"malId":22},28,"Histórico","historico",{"id":31,"name":32,"type":3,"slug":33,"malId":34},40,"Parodia","parodia",20,{"id":36,"name":37,"type":3,"slug":38,"malId":39},42,"Samurai","samurai",21,"Edo es una ciudad que fue hogar del vigor y la ambición de los samuráis de todo el país. Sin embargo, tras la rendición del Japón feudal ante poderosos alienígenas conocidos como los \"Amanto\", esas aspiraciones ahora parecen inalcanzables. Con el shogunato, que en su momento fue influyente, reconstruido como un gobierno títere, se aprueba una nueva ley que prohíbe de inmediato todas las espadas en público.\n\nEntra Gintoki Sakata, un excéntrico hombre de cabello plateado que siempre lleva consigo una espada de madera y mantiene su estatus como samurái a pesar de la prohibición. Como fundador de Yorozuya, un pequeño negocio de trabajos ocasionales, Gintoki a menudo emprende esfuerzos para ayudar a otras personas, aunque generalmente de maneras bastante extrañas e imprevistas.\n\nAsistido por Shinpachi Shimura, un chico con gafas que supuestamente está aprendiendo el camino del samurái; Kagura, una chica andrógina con fuerza sobrehumana y un apetito insaciable; y Sadaharu, su enorme perro mascota que adora morder cabezas, el Yorozuya se enfrenta a cualquier cosa, desde la realeza alienígena hasta peleas con pandillas locales en el siempre cambiante mundo de Edo.",null,"2006-04-04","2010-03-25",7,false,201,8.93,427979,"gintama-season-1",918,"2025-02-23 01:54:00.693221+00","2026-08-25 01:44:22.48471+00",{"id":3,"name":54,"slug":55,"malId":56},"TV Anime","tv-anime","TV",[58,60,62,64,67,70,72,75,78,81,84,87,89,92,95,98,101,104,107,109,111,114,117,119,122,125,127,129,132,135,138,141,144,147,150,153,156,159,162,164,167,169,172,175,178,181,184,187,190,193,196,199,202,205,208,211,214,217,220,223,226,229,232,235,238,241,244,247,250,253,256,259,262,265,268,271,274,277,280,283,286,289,292,295,298,301,304,307,310,313,316,319,322,325,328,331,334,337,340,343,346,349,352,355,358,361,364,367,370,373,376,379,382,385,388,391,394,397,400,403,406,409,412,415,418,421,424,427,430,433,436,439,442,445,448,451,454,457,460,463,466,469,472,475,478,481,484,487,490,493,496,499,502,505,508,511,514,517,520,523,526,529,532,535,538,541,544,547,550,553,556,559,562,565,568,571,574,577,580,583,586,589,592,595,598,601,604,607,610,613,616,619,622,625,628,631,634,636,639,642],{"id":59,"number":3},4553,{"id":61,"number":17},4554,{"id":63,"number":13},4555,{"id":65,"number":66},4556,5,{"id":68,"number":69},4557,6,{"id":71,"number":44},4558,{"id":73,"number":74},4559,8,{"id":76,"number":77},4560,9,{"id":79,"number":80},4561,10,{"id":82,"number":83},4562,11,{"id":85,"number":86},4563,12,{"id":88,"number":22},4564,{"id":90,"number":91},4565,14,{"id":93,"number":94},4566,15,{"id":96,"number":97},4567,16,{"id":99,"number":100},4568,17,{"id":102,"number":103},4569,18,{"id":105,"number":106},4570,19,{"id":108,"number":34},4571,{"id":110,"number":39},4572,{"id":112,"number":113},4573,22,{"id":115,"number":116},4574,23,{"id":118,"number":20},4575,{"id":120,"number":121},4576,